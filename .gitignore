examples/**/videos/
examples/**/pdf/
examples/**/public/screenshots/
examples/**/public/pdf/
examples/**/public/videos/

# TypeScript incremental build state
*.tsbuildinfo

# private-app material, kept local only (not in the public repo)
/reference/
/examples/emh-check/

